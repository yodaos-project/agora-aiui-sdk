AGORA_APP_ID=replace-with-your-32-character-app-id
AGORA_APP_CERTIFICATE=replace-with-your-32-character-certificate
AGORA_PIPELINE_ID=replace-with-your-ai-studio-pipeline-id
AGORA_AREA=AP
# For Shengwang China, set AGORA_AREA=CN and optionally use this API origin.
# AGORA_AGENTS_API_BASE_URL=https://api.sd-rtn.com
# Optional: override the pipeline recognition language, for example zh-CN for Chinese ARES.
AGORA_ASR_LANGUAGE=
# For CN, replace this with the WHIP origin enabled for your project.
AGORA_WHIP_BASE_URL=https://ap-webrtc-whip.ap.sd-rtn.com
BACKEND_API_TOKEN=replace-with-a-random-demo-token-at-least-24-characters
# Optional: this same backend's public HTTPS base URL, reachable by Agora/Shengwang tools.
VOICE_TOOLS_PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8787
